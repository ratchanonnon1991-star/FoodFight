# Frontend Authentication Mode
# Options:
#   "mock" - Local frontend development & UI validation (default in development)
#   "api"  - Real backend API transport adapter (future integration, currently fails closed)
NEXT_PUBLIC_AUTH_MODE=mock

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8888

# Location provider. Keep osm-photon until Google Maps is configured.
NEXT_PUBLIC_LOCATION_PROVIDER=osm-photon
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
