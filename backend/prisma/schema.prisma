
generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  LINE
}

enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  LOBBY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FoodFightStatus {
  COLLECTING_PREFERENCES
  GENERATING_RECOMMENDATIONS
  VOTING
  FINAL_VOTE
  FINALIZED
  RESTAURANT_RECOMMENDATION
  RESTAURANT_SELECTION
  BILLING
  COMPLETED
  CANCELLED
}

enum SessionMemberRole {
  HOST
  MEMBER
}

enum MealBudgetRange {
  UNDER_200
  BETWEEN_200_400
  BETWEEN_400_600
  ABOVE_600
  ANY
}

enum RecommendationRoundStatus {
  GENERATING
  VOTING
  COMPLETED
}

enum VoteAction {
  OK
  PASS
}

enum FinalVoteType {
  TIE_BREAK
  FOUR_MENU_FINAL
}

enum FinalSelectionMethod {
  OK_MAJORITY
  FINAL_VOTE
  HOST_TIE_BREAK
}

enum RestaurantRecommendationStatus {
  ACTIVE
  SELECTED
  REJECTED
}

enum BillStatus {
  DRAFT
  SPLITTING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OcrStatus {
  NOT_USED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(uuid())
  displayName   String
  email         String   @unique
  passwordHash  String?
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  role          Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  refreshTokens     RefreshToken[]
  emailVerification EmailVerification?
  passwordResets    PasswordReset[]

  foodProfile FoodProfile?
  paymentAccount PaymentAccount?

  hostedRooms Room[]       @relation("RoomHost")
  roomMembers RoomMember[]

  sessionMembers  SessionMember[]
  mealPreferences MealPreference[]
  votes           Vote[]
  finalVotes      FinalVote[]

  finalSelections FinalSelection[] @relation("FinalSelectedBy")

  selectedRestaurants RestaurantSelection[] @relation("RestaurantSelectedBy")

  createdBills Bill[]        @relation("BillCreatedBy")
  itemShares   ItemShare[]
  payments     UserPayment[]

  @@map("users")
}

model Account {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])

  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerification {
  id                String   @id @default(uuid())
  userId            String   @unique
  otpHash           String
  expiresAt         DateTime
  resendAvailableAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordReset {
  id                String   @id @default(uuid())
  userId            String
  tokenHash         String   @unique
  expiresAt         DateTime
  resendAvailableAt DateTime
  used              Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model FoodProfile {
  id     String @id @default(uuid())
  userId String @unique

  allergies      String[]
  otherAllergies String?

  restrictions      String[]
  otherRestrictions String?

  additionalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("food_profiles")
}

model PaymentAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  paymentType     String   @default("PROMPTPAY")
  accountName     String
  promptPayNumber String
  qrCodeUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_accounts")
}

model Room {
  id     String @id @default(uuid())
  hostId String

  name String

  roomCode    String @unique
  inviteToken String @unique

  maxMembers Int

  locationName String
  latitude     Float?
  longitude    Float?

  searchRadiusKm Int

  scheduledAt DateTime

  status RoomStatus @default(LOBBY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host User @relation("RoomHost", fields: [hostId], references: [id], onDelete: Restrict)

  members RoomMember[]

  session FoodFightSession?

  @@index([hostId])
  @@index([status])
  @@map("rooms")
}

model RoomMember {
  id     String @id @default(uuid())
  roomId String
  userId String

  isReady Boolean @default(false)

  joinedAt DateTime @default(now())
  leftAt   DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])

  @@index([roomId])
  @@index([userId])

  @@map("room_members")
}

model FoodFightSession {
  id     String @id @default(uuid())
  roomId String @unique

  status FoodFightStatus @default(COLLECTING_PREFERENCES)

  startedAt   DateTime @default(now())
  finalizedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  members SessionMember[]

  preferences MealPreference[]

  recommendationRounds RecommendationRound[]

  finalVotes     FinalVote[]
  finalSelection FinalSelection?

  restaurantRecommendations RestaurantRecommendation[]
  restaurantSelection       RestaurantSelection?

  bill Bill?

  @@index([status])
  @@map("foodfight_sessions")
}

model SessionMember {
  id        String @id @default(uuid())
  sessionId String
  userId    String

  role SessionMemberRole

  joinedAt DateTime @default(now())

  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])

  @@index([sessionId])
  @@index([userId])

  @@map("session_members")
}

model MealPreference {
  id        String @id @default(uuid())
  sessionId String
  userId    String

  cookingTypes     String[]
  otherCookingType String?

  cuisines     String[]
  otherCuisine String?

  ingredients     String[]
  otherIngredient String?

  budgetRange MealBudgetRange?

  restaurantStyles     String[]
  otherRestaurantStyle String?

  otherNote String?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])

  @@index([sessionId])
  @@index([userId])

  @@map("meal_preferences")
}

model RecommendationRound {
  id        String @id @default(uuid())
  sessionId String

  roundNumber Int

  status RecommendationRoundStatus @default(GENERATING)

  generatedAt DateTime @default(now())
  completedAt DateTime?

  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  items RecommendationItem[]

  @@unique([sessionId, roundNumber])

  @@index([sessionId])

  @@map("recommendation_rounds")
}

model RecommendationItem {
  id                    String @id @default(uuid())
  recommendationRoundId String

  menuName    String
  description String?
  reason      String?
  imageUrl    String?

  recommendationScore Float?

  metadata Json?

  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round RecommendationRound @relation(fields: [recommendationRoundId], references: [id], onDelete: Cascade)

  votes Vote[]

  finalVotes      FinalVote[]
  finalSelections FinalSelection[]

  @@index([recommendationRoundId])

  @@map("recommendation_items")
}

model Vote {

  id                   String @id @default(uuid())

  recommendationItemId String

  userId               String



  action VoteAction



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt



  recommendationItem RecommendationItem @relation(fields: [recommendationItemId], references: [id], onDelete: Cascade)



  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@unique([recommendationItemId, userId])



  @@index([recommendationItemId])

  @@index([userId])



  @@map("votes")

}






model FinalVote {

  id                   String @id @default(uuid())

  sessionId            String

  userId               String

  recommendationItemId String



  voteType FinalVoteType



  createdAt DateTime @default(now())



  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)



  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  recommendationItem RecommendationItem @relation(fields: [recommendationItemId], references: [id], onDelete: Cascade)



  @@unique([sessionId, userId, voteType])



  @@index([sessionId])

  @@index([userId])

  @@index([recommendationItemId])



  @@map("final_votes")

}






model FinalSelection {

  id                   String @id @default(uuid())

  sessionId            String @unique

  recommendationItemId String




  selectedById String?



  method FinalSelectionMethod



  selectedAt DateTime @default(now())



  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)



  recommendationItem RecommendationItem @relation(fields: [recommendationItemId], references: [id], onDelete: Restrict)



  selectedBy User? @relation("FinalSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)



  @@index([recommendationItemId])

  @@index([selectedById])



  @@map("final_selections")

}






model RestaurantRecommendation {

  id        String @id @default(uuid())

  sessionId String



  externalPlaceId String?



  name    String

  address String?



  latitude  Float?

  longitude Float?



  distanceMeters Int?



  phone String?



  openingHours Json?



  imageUrl String?




  finalMenuMatch Boolean @default(false)




  varietyScore Float?




  groupCompatibilityScore Float?




  rankingScore Float?





  reason String?



  status RestaurantRecommendationStatus @default(ACTIVE)



  displayOrder Int?



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt



  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)



  @@index([sessionId])

  @@index([externalPlaceId])

  @@index([status])



  @@map("restaurant_recommendations")

}






model RestaurantSelection {

  id        String @id @default(uuid())

  sessionId String @unique



  selectedById String



  externalPlaceId String?



  name    String

  address String?



  latitude  Float?

  longitude Float?



  distanceMeters Int?



  phone String?



  openingHours Json?



  imageUrl String?



  selectedAt DateTime @default(now())



  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)



  selectedBy User @relation("RestaurantSelectedBy", fields: [selectedById], references: [id], onDelete: Restrict)



  @@index([externalPlaceId])

  @@index([selectedById])



  @@map("restaurant_selections")

}






model Bill {

  id        String @id @default(uuid())

  sessionId String @unique



  createdById String



  status BillStatus @default(DRAFT)



  subtotal      Decimal? @db.Decimal(10, 2)

  serviceCharge Decimal? @db.Decimal(10, 2)

  tax           Decimal? @db.Decimal(10, 2)

  discount      Decimal? @db.Decimal(10, 2)



  totalAmount Decimal? @db.Decimal(10, 2)



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt



  session FoodFightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)



  createdBy User @relation("BillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)



  receipt Receipt?



  items ReceiptItem[]



  payments UserPayment[]



  @@index([createdById])

  @@index([status])



  @@map("bills")

}






model Receipt {

  id     String @id @default(uuid())

  billId String @unique



  imageUrl String



  ocrStatus OcrStatus @default(NOT_USED)



  rawOcrText String?



  parsedData Json?



  uploadedAt DateTime @default(now())

  updatedAt  DateTime @updatedAt



  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)



  @@map("receipts")

}






model ReceiptItem {

  id     String @id @default(uuid())

  billId String



  name String



  quantity Int @default(1)



  unitPrice  Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt



  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)



  shares ItemShare[]



  @@index([billId])



  @@map("receipt_items")

}






model ItemShare {

  id            String @id @default(uuid())

  receiptItemId String

  userId        String



  amount Decimal @db.Decimal(10, 2)



  createdAt DateTime @default(now())



  receiptItem ReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)



  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@unique([receiptItemId, userId])



  @@index([receiptItemId])

  @@index([userId])



  @@map("item_shares")

}






model UserPayment {

  id     String @id @default(uuid())

  billId String

  userId String



  amount Decimal @db.Decimal(10, 2)



  status PaymentStatus @default(UNPAID)



  paidAt DateTime?



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt



  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)



  user User @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@unique([billId, userId])



  @@index([billId])

  @@index([userId])



  @@map("user_payments")

}
